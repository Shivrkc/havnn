generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                  @id @default(cuid())
  name               String
  email              String                  @unique
  password           String?
  avatar             String?
  provider           String                  @default("credentials")
  emailVerified      Boolean                 @default(false)
  verificationTokens EmailVerificationToken[]
  projects           Project[]
  githubAccount      GithubAccount?
  oauthStates        GithubOauthState[]
  passwordResetTokens PasswordResetToken[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GithubAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  githubUserId   String   @unique
  githubUsername String
  accessToken    String
  scope          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GithubOauthState {
  id        String   @id @default(cuid())
  stateHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id             String       @id @default(cuid())
  name           String
  description    String?
  repositoryName String?
  repositoryUrl  String?
  branch         String?      @default("main")
  status         String       @default("idle")
  userId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments    Deployment[]

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DeploymentStatus {
  QUEUED
  INITIALIZING
  BUILDING
  BUILT
  FAILED
  CANCELLED
}

enum LogStream {
  STDOUT
  STDERR
  SYSTEM
}

model Deployment {
  id             String           @id @default(cuid())
  projectId      String
  status         DeploymentStatus @default(QUEUED)
  
  workerId       String?
  heartbeatAt    DateTime?
  
  repositoryName String
  repositoryUrl  String
  branch         String
  commitSha      String?
  commitMsg      String?
  commitAuthor   String?
  
  imageTag       String?
  dockerfilePath String           @default("Dockerfile")
  
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  exitCode       Int?
  errorMessage   String?
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs           BuildLog[]

  @@index([projectId])
  @@index([status])
  @@index([status, heartbeatAt])
  @@index([createdAt])
  @@index([projectId, createdAt])
}

model BuildLog {
  id           String     @id @default(cuid())
  deploymentId String
  line         String
  stream       LogStream  @default(STDOUT)
  sequence     Int
  timestamp    DateTime   @default(now())

  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, sequence])
  @@index([deploymentId, sequence])
}

model OAuthState {
  id        String   @id @default(cuid())
  stateHash String   @unique
  provider  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([stateHash])
}

model OAuthExchange {
  id        String   @id @default(cuid())
  codeHash  String   @unique
  token     String
  user      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([codeHash])
}